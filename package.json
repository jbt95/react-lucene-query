{
  "name": "react-lucene-query",
  "version": "0.1.0",
  "description": "Composable, schema-driven Lucene-style query search for React.",
  "homepage": "https://github.com/jbt95/react-lucene-query#readme",
  "bugs": {
    "url": "https://github.com/jbt95/react-lucene-query/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jbt95/react-lucene-query.git"
  },
  "files": [
    "dist",
    "docs",
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./styled": {
      "types": "./dist/styled.d.ts",
      "import": "./dist/styled.js"
    },
    "./codemirror": {
      "types": "./dist/codemirror.d.ts",
      "import": "./dist/codemirror.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "bun run scripts/build.ts && tsc -p tsconfig.build.json && bun run build:css",
    "build:css": "tailwindcss -i src/styles.css -o dist/styles.css --minify",
    "build:example": "vite build",
    "preview:example": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "bun test ./tests",
    "test:browser": "playwright test",
    "check:package": "bun run scripts/check-package.ts",
    "example:backend": "bun run example/backend.ts",
    "check-types": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "bun run check-types && bun run lint && bun run format:check && bun run test && bun run build && bun run build:example && bun run check:package && bun run example:backend",
    "check:all": "bun run check && bun run test:browser",
    "prepack": "bun run build"
  },
  "dependencies": {
    "effect": "^4.0.0"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.0",
    "@codemirror/commands": "^6.10.0",
    "@codemirror/lint": "^6.9.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.38.0",
    "@happy-dom/global-registrator": "^20.0.0",
    "@oxlint/plugins": "1.86.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/cli": "^4.1.0",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "^1.3.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "oxfmt": "^0.61.0",
    "oxlint": "1.86.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.1.0",
    "typescript": "7.0.2",
    "vite": "^7.0.0"
  },
  "peerDependencies": {
    "@codemirror/autocomplete": "^6.20.0",
    "@codemirror/commands": "^6.10.0",
    "@codemirror/lint": "^6.9.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.38.0",
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@codemirror/autocomplete": {
      "optional": true
    },
    "@codemirror/commands": {
      "optional": true
    },
    "@codemirror/lint": {
      "optional": true
    },
    "@codemirror/state": {
      "optional": true
    },
    "@codemirror/view": {
      "optional": true
    }
  },
  "packageManager": "bun@1.4.2"
}
